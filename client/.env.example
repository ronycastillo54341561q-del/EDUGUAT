# URL del backend (sin slash final).
# En Vite las variables deben llevar el prefijo VITE_ y se leen con
# import.meta.env.VITE_API_URL (NO process.env / NO REACT_APP_).
#
# Desarrollo local (valor por defecto si no se define): http://localhost:5000
# Producción (Vercel / servidor): poner aquí la URL pública del backend,
#   ej: https://api.eduguat.com
#
# Copia este archivo como .env y ajusta el valor.
VITE_API_URL=http://localhost:5000
